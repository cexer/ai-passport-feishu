+esp_err_t esp_http_client_defer_get_tx_buffer(esp_http_client_handle_t client)
+{
+    if (!client) return ESP_ERR_INVALID_ARG;
+    if (client->state != HTTP_STATE_INIT) return ESP_ERR_INVALID_STATE;
+    if (client->connection_info.method != HTTP_METHOD_GET || !client->disable_auto_redirect || client->post_len)
+        return ESP_ERR_INVALID_ARG;
+    client->defer_get_tx = true;
+    esp_http_tx_release(&client->request->buffer->data, client->buffer_size_tx, free);
+    ESP_LOGI(TAG, "HTTP_TX_DEFER bytes=%d", client->buffer_size_tx);
+    return ESP_OK;
+}
 
